# ─── 大脑 ───
# claude | stub | glm | deepseek | kimi
#   stub  离线，不调 API、不花钱，用固定剧本驱动前端
#   glm   推荐起步：新用户送 2500 万 token，够用一年
CLAUDIO_BRAIN=glm

# 各家的 key，按上面选的那个填一个即可
# GLM：https://bigmodel.cn  新用户送 2500 万 token
GLM_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=

# Anthropic：注意这跟 Claude Pro/Max 订阅是两套账，
# 订阅不含 API 额度，需要在 console.anthropic.com 单独充值
# ANTHROPIC_API_KEY=sk-ant-...

# 档位。留空则用所选厂商的默认档
#   glm       glm-4.5-air（默认，实测最优）/ glm-4.7-flashx（慢）/ glm-4.7（贵）
#             别用 glm-4.7-flash —— 名义免费但共享容量，实测成功率 1/5、耗时 30-53 秒
#   claude    claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5
# CLAUDIO_MODEL=glm-4.7-flash

# 覆盖端点地址，用于自建代理或换区
# CLAUDIO_BASE_URL=

# ─── 音源 ───
# itunes（免费零鉴权）| applemusic（需 $99/年）| netease（自建）
CLAUDIO_MUSIC_PROVIDER=itunes
# storefront：CN=简体 TW/HK=繁体 US=英文
CLAUDIO_ITUNES_STOREFRONT=CN

PORT=8080
