# Anthropic API key —— 注意：这跟 Claude Pro/Max 订阅是两套账，
# 需要在 console.anthropic.com 单独充值（最低 $5）
ANTHROPIC_API_KEY=sk-ant-...

# 大脑模型。当前用最便宜的 Haiku 4.5（$1/$5 每百万 token）
# 想换更强的：claude-sonnet-5 / claude-opus-5
CLAUDIO_MODEL=claude-haiku-4-5

# 音源 provider：itunes（免费零鉴权）| applemusic（需 $99/年）| netease（自建）
CLAUDIO_MUSIC_PROVIDER=itunes

# iTunes storefront —— CN=简体 TW/HK=繁体 US=英文
CLAUDIO_ITUNES_STOREFRONT=CN

PORT=8080

# 离线开发模式：不调 API、不花钱，用固定剧本驱动前端
# CLAUDIO_BRAIN=stub
