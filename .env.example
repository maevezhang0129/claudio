# ─── 大脑 ───
# claude | stub | glm | deepseek | kimi
#   stub  离线，不调 API、不花钱，用固定剧本驱动前端
#   glm   推荐起步：新用户送 2500 万 token，够用一年
CLAUDIO_BRAIN=glm

# 各家的 key，按上面选的那个填一个即可
# GLM：https://bigmodel.cn  新用户送 2500 万 token
GLM_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=

# Anthropic：注意这跟 Claude Pro/Max 订阅是两套账，
# 订阅不含 API 额度，需要在 console.anthropic.com 单独充值
# ANTHROPIC_API_KEY=sk-ant-...

# 档位。留空则用所选厂商的默认档
#   glm       glm-4.5-air（默认，实测最优）/ glm-4.7-flashx（慢）/ glm-4.7（贵）
#             别用 glm-4.7-flash —— 名义免费但共享容量，实测成功率 1/5、耗时 30-53 秒
#   claude    claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5
# CLAUDIO_MODEL=glm-4.7-flash

# 覆盖端点地址，用于自建代理或换区
# CLAUDIO_BASE_URL=

# ─── 音源 ───
# mixed（默认：网易云认歌 + iTunes 出声）| itunes（免费零鉴权，30 秒试听）
# netease（自建，要 cookie 才能播）| applemusic（需 $99/年，未实现）
# mixed 需要先 npm run netease:api；那个服务没起时它会自动退化成纯 iTunes，
# 启动横幅会明说退化了，不会假装还在混合。
# CLAUDIO_MUSIC_PROVIDER=mixed
# storefront：CN=简体 TW/HK=繁体 US=英文
CLAUDIO_ITUNES_STOREFRONT=CN

# ─── 网易云（provider 为 mixed 或 netease 时都用得上）───
# 先起服务：npm run netease:api
CLAUDIO_NETEASE_BASE_URL=http://localhost:3000
#
# 已登录账号的 cookie。**这是能不能听整曲的唯一开关。**
# 不填：匿名状态下 /song/url 对几乎所有歌返回 null，
#       于是 mixed 只能靠 iTunes 的 30 秒试听，听到的全是片段。
# 填了：你这个账号有权限的曲目会给出整曲直链（VIP 曲目仍然要 VIP）。
#
# 怎么取 —— 不用碰开发者工具：
#   npm run netease:api      # 一个窗口，先起服务
#   npm run netease:login    # 另一个窗口，按提示选登录方式
#   登录成功后这一行会被自动写进 .env，其余内容不动。
#
#   默认走**手机验证码**，不需要装任何 App。
#   扫码那条路要用**网易云音乐 App 的扫一扫** —— 用相机或浏览器扫
#   只会打开一个网页登录页，那是网页登录，完成不了这里需要的握手，
#   终端会一直停在「等待扫码」而手机上看着一切正常。
#
# 手动方式（备用）：
#   1. Chrome 打开 https://music.163.com 并登录
#   2. Cmd+Option+I 打开开发者工具（Mac 上 F12 是音量键），
#      或者直接在页面上右键 → 检查
#   3. Application → Storage → Cookies → https://music.163.com
#   4. 找到 MUSIC_U 那一行，复制它的 Value（很长，300 字符左右）
#   5. 按下面的格式写，注意 MUSIC_U= 这个前缀要保留，值不要加引号
#
# 两种方式都做完之后重启服务，启动横幅应显示
# 「整曲=✓」和「带 cookie，可整曲」
#
# cookie 会过期。过期后不会报错，只会安静退回试听 ——
# 启动横幅那一行就是用来发现这件事的。
# CLAUDIO_NETEASE_COOKIE=MUSIC_U=在这里粘贴那一长串

# ─── 环境注入（阶段③）───
# 天气坐标。默认上海，与提示词里的 Asia/Shanghai 时区一致。
# 用的是 Open-Meteo：免费、零鉴权、不用注册。
CLAUDIO_LAT=31.23
CLAUDIO_LON=121.47
# 读本机 Calendar.app 的今日日程。默认关 ——
# 第一次读会弹系统授权框，而且 Apple Event 慢，那个延迟每轮都要付。
# CLAUDIO_CALENDAR=on

# 到点自动为空着的那一档排期。默认关 —— 这是唯一会花钱的自动路径。
# 打开后每换到一个还没排期的档会调一次模型（glm-4.5-air 约 $0.00055），
# 一天最多等于 routines.md 里写了几个时段。
# CLAUDIO_AUTOPLAN=on

PORT=8080
